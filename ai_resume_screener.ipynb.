        "import pandas as pd\n",
        "\n",
        "def export_to_excel(results, output_path=\"/content/screening_results.xlsx\"):\n",
        "    # Main ranking sheet\n",
        "    ranking_rows = []\n",
        "    for i, r in enumerate(results):\n",
        "        ranking_rows.append({\n",
        "            \"Rank\": i + 1,\n",
        "            \"Name\": r[\"name\"],\n",
        "            \"Overall Score\": r[\"score\"],\n",
        "            \"Skills Match\": r[\"skills_match\"],\n",
        "            \"Experience Match\": r[\"experience_match\"],\n",
        "            \"Recommendation\": r[\"recommendation\"]\n",
        "        })\n",
        "\n",
        "    # Detailed breakdown sheet\n",
        "    detail_rows = []\n",
        "    for r in results:\n",
        "        for strength in r[\"top_strengths\"]:\n",
        "            detail_rows.append({\n",
        "                \"Name\": r[\"name\"],\n",
        "                \"Type\": \"Strength\",\n",
        "                \"Detail\": strength\n",
        "            })\n",
        "        for gap in r[\"gaps\"]:\n",
        "            detail_rows.append({\n",
        "                \"Name\": r[\"name\"],\n",
        "                \"Type\": \"Gap\",\n",
        "                \"Detail\": gap\n",
        "            })\n",
        "\n",
        "    ranking_df = pd.DataFrame(ranking_rows)\n",
        "    detail_df = pd.DataFrame(detail_rows)\n",
        "\n",
        "    with pd.ExcelWriter(output_path, engine=\"openpyxl\") as writer:\n",
        "        ranking_df.to_excel(writer, sheet_name=\"Shortlist Ranking\", index=False)\n",
        "        detail_df.to_excel(writer, sheet_name=\"Detailed Breakdown\", index=False)\n",
        "\n",
        "        # Auto-size columns\n",
        "        for sheet_name in writer.sheets:\n",
        "            ws = writer.sheets[sheet_name]\n",
        "            for col in ws.columns:\n",
        "                max_len = max(len(str(cell.value or \"\")) for cell in col) + 4\n",
        "                ws.column_dimensions[col[0].column_letter].width = min(max_len, 60)\n",
        "\n",
        "    print(f\"Excel file saved to: {output_path}\")\n",
        "    return output_path\n",
