        "def detect_bias(resume_text, candidate_name=\"Candidate\"):\n",
        "    prompt = \"\"\"\n",
        "You are an expert in HR compliance and bias detection.\n",
        "\n",
        "Analyze the following resume and identify any personal information that could lead to discriminatory hiring decisions.\n",
        "\n",
        "Check for the following bias indicators:\n",
        "- Gender: names, pronouns, gendered language\n",
        "- Age: graduation years, birth year, phrases like \"20 years experience\"\n",
        "- Nationality or ethnicity: country of origin, foreign-sounding names, languages\n",
        "- Disability: any mention of health conditions or accessibility needs\n",
        "- Socioeconomic indicators: unpaid internships, university prestige, gaps in employment\n",
        "\n",
        "Resume:\n",
        "\"\"\" + resume_text + \"\"\"\n",
        "\n",
        "Return a JSON object with exactly this structure:\n",
        "{\n",
        "  \"candidate\": \"name or unknown\",\n",
        "  \"bias_flags\": [\n",
        "    {\n",
        "      \"category\": \"category name\",\n",
        "      \"finding\": \"what was found in the resume\",\n",
        "      \"risk\": \"Low / Medium / High\",\n",
        "      \"recommendation\": \"what the recruiter should do\"\n",
        "    }\n",
        "  ],\n",
        "  \"overall_risk\": \"Low / Medium / High\",\n",
        "  \"summary\": \"one sentence overall assessment\"\n",
        "}\n",
        "\n",
        "If no bias indicators are found in a category, do not include it.\n",
        "Return ONLY the JSON object. No explanation, no markdown, no backticks.\n",
        "\"\"\"\n",
        "\n",
        "    message = client.messages.create(\n",
        "        model=\"claude-opus-4-5\",\n",
        "        max_tokens=1500,\n",
        "        messages=[{\"role\": \"user\", \"content\": prompt}]\n",
        "    )\n",
        "\n",
        "    raw = message.content[0].text.strip()\n",
        "    if raw.startswith(\"```\"):\n",
        "        raw = raw.split(\"```\")[1]\n",
        "        if raw.startswith(\"json\"):\n",
        "            raw = raw[4:]\n",
        "\n",
        "    return json.loads(raw.strip())\n",
        "\n",
        "\n",
        "def display_bias_report(bias_result):\n",
        "    print(\"\\n===== BIAS DETECTION REPORT =====\\n\")\n",
        "    print(\"Candidate: \" + bias_result[\"candidate\"])\n",
        "    print(\"Overall Risk Level: \" + bias_result[\"overall_risk\"])\n",
        "    print(\"Summary: \" + bias_result[\"summary\"])\n",
        "    print(\"\\n--- FLAGS ---\\n\")\n",
        "\n",
        "    if not bias_result[\"bias_flags\"]:\n",
        "        print(\"No bias indicators detected.\")\n",
        "    else:\n",
        "        for flag in bias_result[\"bias_flags\"]:\n",
        "            print(\"Category:       \" + flag[\"category\"])\n",
        "            print(\"Finding:        \" + flag[\"finding\"])\n",
        "            print(\"Risk Level:     \" + flag[\"risk\"])\n",
        "            print(\"Recommendation: \" + flag[\"recommendation\"])\n",
        "            print(\"\")\n",
        "\n",
        "\n",
        "def export_bias_report_to_excel(bias_result, output_path=\"/content/bias_report.xlsx\"):\n",
        "    summary_rows = [{\n",
        "        \"Candidate\": bias_result[\"candidate\"],\n",
